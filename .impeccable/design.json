      "html": "<fieldset class=\"ds-environment\"><legend>Launch atmosphere</legend><div class=\"ds-segmented\"><button aria-pressed=\"true\">Daylight</button><button aria-pressed=\"false\">Nightfall</button></div></fieldset>",
      "css": ".ds-environment{font-family:'DM Sans',sans-serif;padding:0;border:0;margin:0;color:#2b352f}.ds-environment legend{font-size:12px;font-weight:650;margin-bottom:12px}.ds-segmented{display:flex;background:#eeece2;padding:4px;border-radius:9px;gap:4px}.ds-segmented button{font-family:'DM Sans',sans-serif;display:flex;align-items:center;justify-content:center;gap:7px;min-height:35px;flex:1;border:0;border-radius:6px;background:transparent;font-size:11px;color:inherit;cursor:pointer}.ds-segmented button[aria-pressed=true]{background:#faf8f2;box-shadow:0 2px 5px #353a2810}.ds-segmented button:hover{color:#ba4729}.ds-segmented button:focus-visible{outline:3px solid #ba4729;outline-offset:4px}"
