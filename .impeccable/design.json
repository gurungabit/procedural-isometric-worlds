    {
      "name": "Aster demo \u2014 Flight telemetry",
      "kind": "custom",
      "description": "Open definition-list rows with aligned tabular numbers, rather than boxed metric cards.",
      "html": "<section class=\"ds-telemetry\" aria-label=\"Simulated flight telemetry\"><h3>Flight telemetry</h3><dl><div><dt>Mission time</dt><dd>T \u2212 00:05</dd></div><div><dt>Altitude</dt><dd>0.00 <small>km</small></dd></div><div><dt>Velocity</dt><dd>0 <small>m/s</small></dd></div><div><dt>Engine thrust</dt><dd>0 <small>%</small></dd></div></dl></section>",
      "css": ".ds-telemetry{font-family:'DM Sans',sans-serif;color:#2b352f;background:#faf8f2}.ds-telemetry h3{font-size:12px;font-weight:650;margin:0}.ds-telemetry dl{margin:15px 0 0}.ds-telemetry dl>div{display:flex;align-items:baseline;justify-content:space-between;margin-top:12px;font-size:12px}.ds-telemetry dt{color:#62675c}.ds-telemetry dd{margin:0;font-variant-numeric:tabular-nums;font-weight:600}.ds-telemetry small{font-size:11px;font-weight:400;color:#62675c}"
