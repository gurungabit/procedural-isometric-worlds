      "html": "<section class=\"ds-sequence\"><h3>Launch sequence</h3><ol><li class=\"ds-done\"><span></span>Preflight checks</li><li class=\"ds-current\"><span></span>Service arms retract</li><li><span></span>Engine ignition</li><li><span></span>Liftoff</li><li><span></span>Clear the tower</li></ol></section>",
      "css": ".ds-sequence{font-family:'DM Sans',sans-serif;border-top:1px solid #dadbd0;padding-top:20px}.ds-sequence h3{font-size:12px;font-weight:650;margin:0;color:#2b352f}.ds-sequence ol{list-style:none;margin:15px 0 0;padding:0}.ds-sequence li{position:relative;display:flex;align-items:center;gap:11px;min-height:28px;font-size:11px;color:#62675c}.ds-sequence li>span{width:7px;height:7px;border:1px solid #a6b09e;border-radius:50%;background:#faf8f2;z-index:1}.ds-sequence li:not(:last-child):after{content:\"\";position:absolute;left:3px;top:18px;width:1px;height:21px;background:#dadbd0}.ds-sequence .ds-current{color:#2b352f}.ds-sequence .ds-current>span{background:#ba4729;border-color:#ba4729}.ds-sequence .ds-done>span{background:#50734d;border-color:#50734d}"
