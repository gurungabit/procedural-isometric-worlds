      "css": ".ds-camera{display:grid;place-items:center;width:38px;height:38px;border:1px solid #dadbd0;border-radius:50%;background:#faf8f2;color:#62675c;cursor:pointer}.ds-camera svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;width:17px;height:17px}.ds-camera:hover{background:#e8e6dc}.ds-camera:focus-visible{outline:3px solid #ba4729;outline-offset:4px}"
    },
    {
