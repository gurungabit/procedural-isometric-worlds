  "components": [
    {
      "name": "Mission action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The full-width action starts or repeats a launch.",
      "html": "<button class=\"ds-launch\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 14c-2-4 0-9 6-12 3 6 2 11-2 13l-4-1Z M9 10 5 12l-1 5 5-3m5 0 1 5 4-3-2-5M8 18l-2 3m5-3-1 3\"/><circle cx=\"13\" cy=\"7\" r=\"1.5\"/></svg><span>Initiate launch</span><svg class=\"ds-arrow\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></button>",
      "css": ".ds-launch{font-family:'DM Sans',sans-serif;width:100%;min-height:49px;display:flex;align-items:center;gap:10px;background:var(--accent,#ba4729);color:#fff9ed;border:0;border-radius:8px;padding:12px 16px;font-size:12px;font-weight:600;cursor:pointer;transition:background .2s,transform .2s}.ds-launch svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;}.ds-launch .ds-arrow{margin-left:auto;width:17px}.ds-launch:hover:not(:disabled){background:#a63b20;transform:translateY(-1px)}.ds-launch:focus-visible{outline:3px solid var(--accent,#ba4729);outline-offset:4px}.ds-launch:disabled{cursor:default;opacity:.55}@media(prefers-reduced-motion:reduce){.ds-launch{transition:none}}"
    },
    {
      "name": "Camera reset",
      "kind": "button",
      "refersTo": "button-camera",
      "description": "Circular scene inspection control.",
      "html": "<button class=\"ds-camera\" aria-label=\"Reset camera view\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 10a8 8 0 1 1 1 7M4 4v6h6\"/></svg></button>",
      "css": ".ds-camera{display:grid;place-items:center;width:38px;height:38px;border:1px solid var(--line,#dadbd0);border-radius:50%;background:var(--paper,#faf8f2);color:var(--muted,#62675c);cursor:pointer}.ds-camera svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;width:17px;height:17px}.ds-camera:hover{background:#e8e6dc}.ds-camera:focus-visible{outline:3px solid var(--accent,#ba4729);outline-offset:4px}"
    },
    {
      "name": "Atmosphere selection",
      "kind": "custom",
      "refersTo": "button-segment",
      "description": "Pressed state selects the scene lighting, with a tonal track and soft selected shadow.",
      "html": "<fieldset class=\"ds-environment\"><legend>Launch atmosphere</legend><div class=\"ds-segmented\"><button aria-pressed=\"true\">Daylight</button><button aria-pressed=\"false\">Nightfall</button></div></fieldset>",
      "css": ".ds-environment{font-family:'DM Sans',sans-serif;padding:0;border:0;margin:0;color:var(--ink,#2b352f)}.ds-environment legend{font-size:12px;font-weight:650;margin-bottom:12px}.ds-segmented{display:flex;background:#eeece2;padding:4px;border-radius:9px;gap:4px}.ds-segmented button{font-family:'DM Sans',sans-serif;display:flex;align-items:center;justify-content:center;gap:7px;min-height:35px;flex:1;border:0;border-radius:6px;background:transparent;font-size:11px;color:inherit;cursor:pointer}.ds-segmented button[aria-pressed=true]{background:var(--paper,#faf8f2);box-shadow:0 2px 5px #353a2810}.ds-segmented button:hover{color:var(--accent,#ba4729)}.ds-segmented button:focus-visible{outline:3px solid var(--accent,#ba4729);outline-offset:4px}"
    },
    {
      "name": "Playback speed",
      "kind": "button",
      "refersTo": "button-speed-selected",
      "description": "Two compact options expose simulation speed through pressed state.",
      "html": "<div class=\"ds-speed\" role=\"group\" aria-label=\"Playback speed\"><button aria-pressed=\"true\">1×</button><button aria-pressed=\"false\">2×</button></div>",
      "css": ".ds-speed{display:flex;gap:3px}.ds-speed button{font-family:'DM Sans',sans-serif;border:0;background:transparent;border-radius:5px;padding:5px 8px;font-size:11px;color:var(--ink,#2b352f);cursor:pointer}.ds-speed button[aria-pressed=true]{background:#e8e9dc}.ds-speed button:focus-visible{outline:3px solid var(--accent,#ba4729);outline-offset:4px}"
    },
    {
      "name": "Flight telemetry",
      "kind": "custom",
      "description": "Open definition-list rows with aligned tabular numbers, rather than boxed metric cards.",
      "html": "<section class=\"ds-telemetry\" aria-label=\"Simulated flight telemetry\"><h3>Flight telemetry</h3><dl><div><dt>Mission time</dt><dd>T − 00:05</dd></div><div><dt>Altitude</dt><dd>0.00 <small>km</small></dd></div><div><dt>Velocity</dt><dd>0 <small>m/s</small></dd></div><div><dt>Engine thrust</dt><dd>0 <small>%</small></dd></div></dl></section>",
      "css": ".ds-telemetry{font-family:'DM Sans',sans-serif;color:var(--ink,#2b352f);background:var(--paper,#faf8f2)}.ds-telemetry h3{font-size:12px;font-weight:650;margin:0}.ds-telemetry dl{margin:15px 0 0}.ds-telemetry dl>div{display:flex;align-items:baseline;justify-content:space-between;margin-top:12px;font-size:12px}.ds-telemetry dt{color:var(--muted,#62675c)}.ds-telemetry dd{margin:0;font-variant-numeric:tabular-nums;font-weight:600}.ds-telemetry small{font-size:11px;font-weight:400;color:var(--muted,#62675c)}"
    },
    {
      "name": "Launch sequence",
      "kind": "custom",
      "description": "Connected ordered dots encode upcoming, current, and complete phases.",
      "html": "<section class=\"ds-sequence\"><h3>Launch sequence</h3><ol><li class=\"ds-done\"><span></span>Preflight checks</li><li class=\"ds-current\"><span></span>Service arms retract</li><li><span></span>Engine ignition</li><li><span></span>Liftoff</li><li><span></span>Clear the tower</li></ol></section>",
      "css": ".ds-sequence{font-family:'DM Sans',sans-serif;border-top:1px solid var(--line,#dadbd0);padding-top:20px}.ds-sequence h3{font-size:12px;font-weight:650;margin:0;color:var(--ink,#2b352f)}.ds-sequence ol{list-style:none;margin:15px 0 0;padding:0}.ds-sequence li{position:relative;display:flex;align-items:center;gap:11px;min-height:28px;font-size:11px;color:var(--muted,#62675c)}.ds-sequence li>span{width:7px;height:7px;border:1px solid #a6b09e;border-radius:50%;background:var(--paper,#faf8f2);z-index:1}.ds-sequence li:not(:last-child):after{content:\"\";position:absolute;left:3px;top:18px;width:1px;height:21px;background:var(--line,#dadbd0)}.ds-sequence .ds-current{color:var(--ink,#2b352f)}.ds-sequence .ds-current>span{background:var(--accent,#ba4729);border-color:var(--accent,#ba4729)}.ds-sequence .ds-done>span{background:var(--green,#50734d);border-color:var(--green,#50734d)}"
    },
    {
      "name": "Mission panel",
      "kind": "custom",
      "refersTo": "mission-panel",
      "description": "Paper sidebar container; mobile changes its separator to the top edge.",
      "html": "<aside class=\"ds-panel\"><h2>Ready for liftoff?</h2><p>Meet Aster-01. A heavy-lift explorer with a little extra ambition.</p></aside>",
      "css": ".ds-panel{font-family:'DM Sans',sans-serif;padding:30px 25px 23px;background:var(--paper,#faf8f2);border-left:1px solid var(--line,#dadbd0);color:var(--ink,#2b352f)}.ds-panel h2{font-family:Manrope,sans-serif;font-size:23px;line-height:1.25;letter-spacing:-.03em;font-weight:750;margin:0 0 11px}.ds-panel p{font-size:12px;line-height:1.65;color:var(--muted,#62675c);margin:0}"
